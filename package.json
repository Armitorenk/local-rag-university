{
  "name": "local-rag-university",
  "version": "2.0.0",
  "description": "Offline RAG-powered university student support assistant using Foundry Local (Phi-3.5 Mini) + SQLite TF-IDF retrieval",
  "type": "module",
  "scripts": {
    "ingest": "node src/ingest.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "foundry-local-sdk": "^0.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Armitorenk/local-rag-university.git"
  },
  "keywords": [
    "rag",
    "offline-ai",
    "foundry-local",
    "phi-3",
    "university",
    "student-assistant",
    "sqlite",
    "tfidf"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.1.0"
  }
}
